<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.insignia</groupId>
    <artifactId>MicroservicePipeline</artifactId>
    <version>1.0-SNAPSHOT</version>

    <name>Microservice Pipeline</name>
    <packaging>pom</packaging>

    <modules>
        <module>/Backend/Microservices/BuildModules</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.sonatype.plugins</groupId>
                <artifactId>nxrm3-maven-plugin</artifactId>
                <version>1.0.6</version>
                <extensions>true</extensions>
                <configuration>
                    <nexusUrl>http://44.193.71.208:8081</nexusUrl>
                    <serverId>nexus</serverId>
                    <repository>microservices-central-repo</repository>
                    <repositoryUrl>http://44.193.71.208:8081/repository/microservices-central-repo/</repositoryUrl>
                    <skipNexusStagingDeplyMojo>true</skipNexusStagingDeplyMojo>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
